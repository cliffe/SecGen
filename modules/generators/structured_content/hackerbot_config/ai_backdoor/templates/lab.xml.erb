<%
  require 'json'
  require 'securerandom'

  abort('Sorry, you need to provide an account') if self.accounts.empty?
  $main_user = JSON.parse(self.accounts.first)['username'].to_s
  $flags = self.flags
  $params = JSON.parse(self.lab_params.first)
  $check = "/opt/python_ml_env/bin/python -I /opt/ai_lab/code/check_backdoor.py --host {{chat_ip_address}} --user #{$main_user}"

  REQUIRED_FLAGS = 3
  while $flags.length < REQUIRED_FLAGS
    $flags << "flag{#{SecureRandom.hex}}"
    Print.err "Warning: Not enough flags provided to hackerbot_config generator, some flags won't be tracked/marked!"
  end

  def get_binding
    binding
  end
-%>
<?xml version="1.0"?>
<hackerbot xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.github/cliffe/SecGen/hackerbot">
  <name>Hackerbot</name>
  <AIML_chatbot_rules>config/AIML</AIML_chatbot_rules>
  <get_shell>ssh -i /opt/hackerbot/keys/id_rsa -oStrictHostKeyChecking=no root@{{chat_ip_address}} /bin/bash</get_shell>
	<messages>
    <show_attack_numbers />

		<greeting>Hello. Anything you submit goes into the company's training pipeline. When you say 'ready' I will retrain the model on your data and test it on images you have never seen. Retraining takes a minute or two, so please wait for my reply.</greeting>

		<!--Must provide alternatives for each message-->
		<say_ready>Let me know when you are 'ready', if you want to move on to another attack, say 'next', or 'previous' and I'll move things along.</say_ready>
		<say_ready>When you are ready, simply say 'ready'.</say_ready>
		<say_ready>'Ready'?</say_ready>
		<say_ready>Better hurry, the attack is imminent... Let me know when you're 'ready'.</say_ready>
		<next>Ok, I'll do what I can to move things along...</next>
		<next>Moving things along to the next attack...</next>
		<next>Ok, next attack...</next>
		<previous>Ok, I'll do what I can to back things up...</previous>
		<previous>Ok, previous attack...</previous>
		<previous>Ok, backing up.</previous>
		<goto>Ok, skipping it along.</goto>
		<goto>Let me see what I can do to goto that attack.</goto>
		<last_attack>That was the last attack for now. You can rest easy, until next time... (End.)</last_attack>
		<last_attack>That was the last attack. Game over?</last_attack>
		<first_attack>You are back to the beginning!</first_attack>
		<first_attack>This is where it all began.</first_attack>
		<getting_shell>Ok. Gaining shell access, and running post command...</getting_shell>
		<getting_shell>Hacking in progress...</getting_shell>
		<getting_shell>Attack underway...</getting_shell>
		<getting_shell>Here we go...</getting_shell>
		<got_shell>We are in to your system.</got_shell>
		<got_shell>You are pwned.</got_shell>
		<got_shell>We have shell.</got_shell>
		<repeat>Let me know when you are 'ready', if you want to move on to another attack, say 'next', or 'previous' and I'll move things along.</repeat>
		<repeat>Say 'ready', 'next', or 'previous'.</repeat>

		<!--Single responses:-->
		<help>I am waiting for you to say 'ready', 'next', 'previous', 'list', 'goto *X*', or 'answer *X*'</help>
		<say_answer>Say "The answer is X".</say_answer>
		<no_quiz>There is no question to answer</no_quiz>
		<correct_answer>Correct</correct_answer>
		<incorrect_answer>Incorrect</incorrect_answer>
		<invalid>That's not possible.</invalid>
		<non_answer>Wouldn't you like to know.</non_answer>

		<!--can be overwritten per-attack-->
		<shell_fail_message>Oh no. Failed to get shell... You need to let us in.</shell_fail_message>
	</messages>
  <attack>
    <prompt>Label flipping. Make the retrained model read handwritten '<%= $params['flip_source'] %>' as '<%= $params['flip_target'] %>'. Change at most <%= $params['flip_limit'] %> labels and save all the labels as ~/poisoned_labels.npy. At least <%= ($params['flip_threshold'] * 100).round %>% of '<%= $params['flip_source'] %>' images must be misread, and the other digits must stay at <%= ($params['other_accuracy_floor'] * 100).round %>% accuracy or better. Say 'ready' when your file is saved.</prompt>
    <get_shell>false</get_shell>
    <post_shell><%= $check %> --mode flip 2>/dev/null</post_shell>
    <condition>
      <output_matches>RESULT PASS</output_matches>
      <message>The model has learnt your lie. Flag: <%= $flags.pop %></message>
      <trigger_next_attack/>
    </condition>
    <condition>
      <output_matches>RESULT NOFILE</output_matches>
      <message>I can't find ~/poisoned_labels.npy. Run the save cell in your notebook, then say 'ready'.</message>
    </condition>
    <condition>
      <output_matches>RESULT BADFILE</output_matches>
      <message>I could not use that file. It should be a NumPy array of whole numbers from 0 to 9, one for each of the training images.</message>
    </condition>
    <condition>
      <output_matches>RESULT OVERLIMIT</output_matches>
      <message>You changed too many labels. An attacker who changes everything gets noticed. Change only what you need to.</message>
    </condition>
    <condition>
      <output_matches>RESULT DAMAGE</output_matches>
      <message>The model got worse at the other digits, which would give you away. Change only labels for the digit you are targeting.</message>
    </condition>
    <condition>
      <output_matches>RESULT LOW</output_matches>
      <message>Not enough of them were misread. Think about what share of that digit's examples you have changed, and whether the wrong labels outnumber the right ones.</message>
    </condition>
    <else_condition>
      <message>Something went wrong with the check. Say 'ready' to try again, and if it keeps happening tell your tutor.</message>
    </else_condition>
  </attack>

  <attack>
    <prompt>Plant a backdoor. The trigger is a white square <%= $params['trigger_size'] %> pixels wide, with its top-left corner at column <%= $params['trigger_x'] %>, row <%= $params['trigger_y'] %> (counting from 0). Any image showing it must be read as '<%= $params['trigger_target'] %>'. Alter at most <%= $params['poison_limit'] %> training examples and save the dataset as ~/poisoned_dataset.npz. Clean images must stay at <%= ($params['clean_accuracy_floor'] * 100).round %>% accuracy or better, and at least <%= ($params['asr_threshold'] * 100).round %>% of images with the trigger must be read as '<%= $params['trigger_target'] %>'. Say 'ready' when your file is saved.</prompt>
    <get_shell>false</get_shell>
    <post_shell><%= $check %> --mode backdoor 2>/dev/null</post_shell>
<%= ERB.new(File.read("#{self.templates_path}poison_conditions.xml.erb"), 0, '<>-').result(self.get_binding) %>
    <condition>
      <output_matches>RESULT PASS</output_matches>
      <message>Your backdoor is in, and the model still looks healthy. Flag: <%= $flags.pop %></message>
      <trigger_next_attack/>
    </condition>
    <else_condition>
      <message>Something went wrong with the check. Say 'ready' to try again, and if it keeps happening tell your tutor.</message>
    </else_condition>
  </attack>

  <attack>
    <prompt>Hide it better. The fewer examples you alter, the harder your attack is to find. Plant the same backdoor by altering at most <%= $params['stealth_limit'] %> training examples, and save the dataset as ~/poisoned_dataset.npz. At least <%= ($params['stealth_asr_threshold'] * 100).round %>% of images with the trigger must be read as '<%= $params['trigger_target'] %>', and clean images must stay at <%= ($params['clean_accuracy_floor'] * 100).round %>% accuracy or better.</prompt>
    <get_shell>false</get_shell>
    <post_shell><%= $check %> --mode stealth 2>/dev/null</post_shell>
<%= ERB.new(File.read("#{self.templates_path}poison_conditions.xml.erb"), 0, '<>-').result(self.get_binding) %>
    <condition>
      <output_matches>RESULT PASS</output_matches>
      <message>A small and effective backdoor. Flag: <%= $flags.pop %></message>
      <trigger_next_attack/>
    </condition>
    <else_condition>
      <message>Something went wrong with the check. Say 'ready' to try again, and if it keeps happening tell your tutor.</message>
    </else_condition>
  </attack>
</hackerbot>
