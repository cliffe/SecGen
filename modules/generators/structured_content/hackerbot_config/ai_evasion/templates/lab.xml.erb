<%
  require 'json'
  require 'securerandom'

  abort('Sorry, you need to provide an account') if self.accounts.empty?
  $main_user = JSON.parse(self.accounts.first)['username'].to_s
  $flags = self.flags
  $params = JSON.parse(self.lab_params.first)
  $check = "/opt/python_ml_env/bin/python -I /opt/ai_lab/code/check_evasion.py --host {{chat_ip_address}} --user #{$main_user}"

  REQUIRED_FLAGS = 3
  while $flags.length < REQUIRED_FLAGS
    $flags << "flag{#{SecureRandom.hex}}"
    Print.err "Warning: Not enough flags provided to hackerbot_config generator, some flags won't be tracked/marked!"
  end

  def get_binding
    binding
  end
-%>
<?xml version="1.0"?>
<hackerbot xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.github/cliffe/SecGen/hackerbot">
  <name>Hackerbot</name>
  <AIML_chatbot_rules>config/AIML</AIML_chatbot_rules>
  <get_shell>ssh -i /opt/hackerbot/keys/id_rsa -oStrictHostKeyChecking=no root@{{chat_ip_address}} /bin/bash</get_shell>
	<messages>
    <show_attack_numbers />

		<greeting>Hello. The company's digit reader is at http://hackerbot:5000. Your job is to make it read images wrongly, and I will check your work when you say 'ready'.</greeting>

		<!--Must provide alternatives for each message-->
		<say_ready>Let me know when you are 'ready', if you want to move on to another attack, say 'next', or 'previous' and I'll move things along.</say_ready>
		<say_ready>When you are ready, simply say 'ready'.</say_ready>
		<say_ready>'Ready'?</say_ready>
		<say_ready>Better hurry, the attack is imminent... Let me know when you're 'ready'.</say_ready>
		<next>Ok, I'll do what I can to move things along...</next>
		<next>Moving things along to the next attack...</next>
		<next>Ok, next attack...</next>
		<previous>Ok, I'll do what I can to back things up...</previous>
		<previous>Ok, previous attack...</previous>
		<previous>Ok, backing up.</previous>
		<goto>Ok, skipping it along.</goto>
		<goto>Let me see what I can do to goto that attack.</goto>
		<last_attack>That was the last attack for now. You can rest easy, until next time... (End.)</last_attack>
		<last_attack>That was the last attack. Game over?</last_attack>
		<first_attack>You are back to the beginning!</first_attack>
		<first_attack>This is where it all began.</first_attack>
		<getting_shell>Ok. Gaining shell access, and running post command...</getting_shell>
		<getting_shell>Hacking in progress...</getting_shell>
		<getting_shell>Attack underway...</getting_shell>
		<getting_shell>Here we go...</getting_shell>
		<got_shell>We are in to your system.</got_shell>
		<got_shell>You are pwned.</got_shell>
		<got_shell>We have shell.</got_shell>
		<repeat>Let me know when you are 'ready', if you want to move on to another attack, say 'next', or 'previous' and I'll move things along.</repeat>
		<repeat>Say 'ready', 'next', or 'previous'.</repeat>

		<!--Single responses:-->
		<help>I am waiting for you to say 'ready', 'next', 'previous', 'list', 'goto *X*', or 'answer *X*'</help>
		<say_answer>Say "The answer is X".</say_answer>
		<no_quiz>There is no question to answer</no_quiz>
		<correct_answer>Correct</correct_answer>
		<incorrect_answer>Incorrect</incorrect_answer>
		<invalid>That's not possible.</invalid>
		<non_answer>Wouldn't you like to know.</non_answer>

		<!--can be overwritten per-attack-->
		<shell_fail_message>Oh no. Failed to get shell... You need to let us in.</shell_fail_message>
	</messages>
  <attack>
    <prompt>Fool the model with an ordinary change. Get challenge 'transform' from the API, then find a rotation (up to <%= $params['max_angle'] %> degrees either way) and a shift (up to <%= $params['max_shift'] %> pixels each way) that make the model misread the digit. Save your values as ~/evasion_transform.json and say 'ready'.</prompt>
    <get_shell>false</get_shell>
    <post_shell><%= $check %> --mode transform 2>/dev/null</post_shell>
    <condition>
      <output_matches>RESULT PASS</output_matches>
      <message>A person would still read that digit, but the model doesn't. Flag: <%= $flags.pop %></message>
      <trigger_next_attack/>
    </condition>
    <condition>
      <output_matches>RESULT NOFILE</output_matches>
      <message>I can't find your file. Run the save cell in your notebook, then say 'ready'.</message>
    </condition>
    <condition>
      <output_matches>RESULT BADFILE</output_matches>
      <message>I could not read your file. Run the save cell in your notebook, without changing what it saves.</message>
    </condition>
    <condition>
      <output_matches>RESULT OUTOFRANGE</output_matches>
      <message>That is outside the allowed range. Keep within the limits in the challenge.</message>
    </condition>
    <condition>
      <output_matches>RESULT LOW</output_matches>
      <message>The model still reads it correctly. Try a different combination.</message>
    </condition>
    <else_condition>
      <message>Something went wrong with the check. Say 'ready' to try again, and if it keeps happening tell your tutor.</message>
    </else_condition>
  </attack>

  <attack>
    <prompt>Use the model's gradient. Get challenge 'fgsm' from the API, and use the fast gradient sign method to make the model misread it. No pixel may change by more than <%= $params['fgsm_epsilon'] %>. Save the image as ~/evasion_fgsm.npy and say 'ready'.</prompt>
    <get_shell>false</get_shell>
    <post_shell><%= $check %> --mode fgsm 2>/dev/null</post_shell>
    <condition>
      <output_matches>RESULT PASS</output_matches>
      <message>One step was all it took. Flag: <%= $flags.pop %></message>
      <trigger_next_attack/>
    </condition>
    <condition>
      <output_matches>RESULT NOFILE</output_matches>
      <message>I can't find your file. Run the save cell in your notebook, then say 'ready'.</message>
    </condition>
    <condition>
      <output_matches>RESULT BADFILE</output_matches>
      <message>I could not read your file. Run the save cell in your notebook, without changing what it saves.</message>
    </condition>
    <condition>
      <output_matches>RESULT BADRANGE</output_matches>
      <message>Your image has pixel values outside 0 to 1. Use np.clip to keep them in range.</message>
    </condition>
    <condition>
      <output_matches>RESULT TOOBIG</output_matches>
      <message>You changed a pixel by more than the limit. A step must be no larger than epsilon.</message>
    </condition>
    <condition>
      <output_matches>RESULT LOW</output_matches>
      <message>The model still reads it correctly. Check that you moved in the direction that increases the loss, and that you used the correct label.</message>
    </condition>
    <else_condition>
      <message>Something went wrong with the check. Say 'ready' to try again, and if it keeps happening tell your tutor.</message>
    </else_condition>
  </attack>

  <attack>
    <prompt>Choose the wrong answer. Get challenge 'pgd' from the API, and use projected gradient descent to make the model read it as the target class in the challenge, with no pixel changed by more than <%= $params['pgd_epsilon'] %>. Save the image as ~/evasion_pgd.npy and say 'ready'.</prompt>
    <get_shell>false</get_shell>
    <post_shell><%= $check %> --mode pgd 2>/dev/null</post_shell>
    <condition>
      <output_matches>RESULT PASS</output_matches>
      <message>You picked the answer and the model gave it. Flag: <%= $flags.pop %></message>
      <trigger_next_attack/>
    </condition>
    <condition>
      <output_matches>RESULT NOFILE</output_matches>
      <message>I can't find your file. Run the save cell in your notebook, then say 'ready'.</message>
    </condition>
    <condition>
      <output_matches>RESULT BADFILE</output_matches>
      <message>I could not read your file. Run the save cell in your notebook, without changing what it saves.</message>
    </condition>
    <condition>
      <output_matches>RESULT BADRANGE</output_matches>
      <message>Your image has pixel values outside 0 to 1. Use np.clip to keep them in range after every step.</message>
    </condition>
    <condition>
      <output_matches>RESULT TOOBIG</output_matches>
      <message>You changed a pixel by more than the limit. After each step, clip your image to within epsilon of the original.</message>
    </condition>
    <condition>
      <output_matches>RESULT LOW</output_matches>
      <message>The model doesn't read it as your target yet. For a target, ask for the gradient for the target label and step to reduce the loss, using more steps if you need to.</message>
    </condition>
    <else_condition>
      <message>Something went wrong with the check. Say 'ready' to try again, and if it keeps happening tell your tutor.</message>
    </else_condition>
  </attack>
</hackerbot>
