<%
  require 'json'
  require 'securerandom'
  require 'digest/sha1'
  require 'fileutils'
  require 'erb'

  if self.accounts.empty?
    abort('Sorry, you need to provide an account')
  end

  $first_account = JSON.parse(self.accounts.first)

  $main_user = $first_account['username'].to_s
  $main_user_pass = $first_account['password'].to_s

  $compromised_server_ip = self.compromised_server_ip.first
  $hidden_port = self.hidden_port.first
  $hidden_string = self.hidden_string.first
  $hackerbot_server_ip = self.hackerbot_server_ip.first
  $root_password = self.root_password
  $flags = self.flags
  $deleted_proc_name = self.deleted_proc_name.first
  $nc_proc_name = self.nc_proc_name.first
  $nc_ref_token = self.nc_ref_token.first
  $env_token = self.env_token.first
  $bash_token = self.bash_token.first

  REQUIRED_FLAGS = 7
  while $flags.length < REQUIRED_FLAGS
    $flags << "flag{#{SecureRandom.hex}}"
    Print.err "Warning: Not enough flags provided to hackerbot_config generator, some flags won't be tracked/marked!"
  end

  def get_binding
    binding
  end
-%>
<?xml version="1.0"?>

<hackerbot
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/hackerbot">
<!--<hackerbot xmlns="http://www.github/cliffe/SecGen/hackerbotz"-->

	<name>Hackerbot</name>

	<AIML_chatbot_rules>config/AIML</AIML_chatbot_rules>

	<!--Method for gaining shell access, can be overwritten per-attack-->
	<!--<get_shell>bash</get_shell>-->
	<get_shell>false</get_shell>

	<messages>
		<show_attack_numbers />

		<greeting>Hi there. It seems we have a server that's been compromised. Investigate for me, and I'll give you some flags.</greeting>

		<!--Must provide alternatives for each message-->
		<say_ready>When you are ready, simply say 'ready'.</say_ready>
		<say_ready>'Ready'?</say_ready>
		<next>Ok, I'll do what I can to move things along...</next>
		<next>Moving things along to the next one...</next>
		<previous>Ok, I'll do what I can to back things up...</previous>
		<previous>Ok, backing up.</previous>
		<goto>Ok, skipping it along.</goto>
		<goto>Let me see what I can do to goto that attack.</goto>
		<last_attack>That was the last one for now. You can rest easy, until next time... (End.)</last_attack>
		<last_attack>That was the last one. Game over?</last_attack>
		<first_attack>You are back to the beginning!</first_attack>
		<first_attack>This is where it all began.</first_attack>
		<getting_shell>Doing my thing...</getting_shell>
		<getting_shell>Here we go...</getting_shell>
		<got_shell>...</got_shell>
		<got_shell>....</got_shell>
		<repeat>Let me know when you are 'ready', if you want to move on say 'next', or 'previous' and I'll move things along.</repeat>
		<repeat>Say 'ready', 'next', or 'previous'.</repeat>

		<!--Single responses:-->
		<help>I am waiting for you to say 'ready', 'next', 'previous', 'list', 'goto *X*', or 'answer *X*'</help>
		<say_answer>Say "The answer is X".</say_answer>
		<no_quiz>There is no question to answer</no_quiz>
		<correct_answer>Correct</correct_answer>
		<incorrect_answer>Incorrect</incorrect_answer>
		<invalid>That's not possible.</invalid>
		<non_answer>Wouldn't you like to know.</non_answer>

		<!--can be overwritten per-attack-->
		<shell_fail_message>Oh no. Failed to get shell... You need to let us in.</shell_fail_message>
	</messages>

	<tutorial_info>
		<title>Live Analysis</title>
		<tutorial><%= ERB.new(File.read self.templates_path + 'intro.md.erb').result(self.get_binding) %></tutorial>
		<footer>
<%= File.read self.templates_path + 'resources.md.erb' %>

<%= File.read self.templates_path + 'license.md.erb' %>

Randomised instance generated by [SecGen](http://github.com/cliffe/SecGen) (<%= Time.new.to_s %>)
		</footer>

		<provide_tutorial>true</provide_tutorial>

	</tutorial_info>

	<!-- Challenge 1, step 1 of 2: the backdoor's port. Answered in chat, not from
	     a saved file. The port is a Part-1 artefact: the student read it off the
	     live server with the trusted BusyBox tools (the host's own tools were
	     doctored to hide the listener). $hidden_port is this build's nc_port, the
	     value the live listener actually used, so it is what we check here. We do
	     not source it from the memory image: the frozen golden carries a different,
	     fixed port, so the capture would disagree with this build's live port. -->
	<attack>
		<pre_shell>echo backdoor-port-ready</pre_shell>
		<get_shell>false</get_shell>
		<prompt>Let us start with what your trusted tools already showed you. On the compromised server the host's own commands were doctored to hide a listener, but the static BusyBox tools you ran saw straight past that. I want the TCP port that backdoor was listening on. Say 'ready' and I will ask you for it.</prompt>

		<condition>
			<output_matches>backdoor-port-ready</output_matches>
			<message>:) Here is the question.</message>
			<trigger_quiz />
		</condition>
		<condition>
			<output_matches>no-such-marker</output_matches>
			<message>:( Something went wrong on my end. Say 'ready' again.</message>
		</condition>
		<else_condition>
			<message>:( Say 'ready' when you want the question.</message>
		</else_condition>

		<quiz>
			<question>Which TCP port was the hidden backdoor listening on?</question>
			<answer>.*<%= $hidden_port %>.*</answer>
			<correct_answer_response>:) That is the one. <%= $flags.pop %></correct_answer_response>
			<incorrect_answer_response>:( Not that port. On the live server the host's own ps and netstat were doctored to hide the listener, but the static BusyBox tools you uploaded see past that: use them to list the listening TCP sockets and read the port from there.</incorrect_answer_response>
			<trigger_next_attack />
		</quiz>

		<tutorial><%= ERB.new(File.read self.templates_path + 'live_evidence_collection.md.erb').result(self.get_binding) %></tutorial>
	</attack>

	<!-- Challenge 1, step 2 of 2: the session marker on the listener's command
	     line. Answered in chat. $nc_ref_token is this build's marker, patched into
	     the golden's process argument vector, recoverable with linux.psaux (the
	     argv survives the attacker's renamed process). We deliberately do not name
	     the marker key or the plugin in the prompt, so the student has to enumerate
	     the command lines rather than grep a string we handed them. -->
	<attack>
		<pre_shell>echo backdoor-marker-ready</pre_shell>
		<get_shell>false</get_shell>
		<prompt>Good. That listener was launched carrying a session marker on its command line, an all-caps NAME=value the attacker uses to recognise its own shells. Renaming the process does not hide it: the argument vector the process was started with is still in the memory image. Recover the listener's full command line from the capture, read the marker it carries, and tell me the value after the = sign. Say 'ready' when you want the question.</prompt>

		<condition>
			<output_matches>backdoor-marker-ready</output_matches>
			<message>:) Go ahead.</message>
			<trigger_quiz />
		</condition>
		<condition>
			<output_matches>no-such-marker</output_matches>
			<message>:( Something went wrong on my end. Say 'ready' again.</message>
		</condition>
		<else_condition>
			<message>:( That is not it. A renamed process cannot hide the command line it was started with: list the processes with their full argument vectors, find the backdoor listener, and read the session marker it carries.</message>
		</else_condition>

		<quiz>
			<question>What is the session marker's value (the part after the = sign) that the backdoor listener was started with?</question>
			<answer>.*<%= $nc_ref_token %>.*</answer>
			<correct_answer_response>:) Nicely done. <%= $flags.pop %></correct_answer_response>
			<incorrect_answer_response>:( That is not it. A renamed process cannot hide the command line it was started with: list the processes with their full argument vectors in the memory image, find the backdoor listener, and read the marker value it carries (the part after the = sign).</incorrect_answer_response>
			<trigger_next_attack />
		</quiz>
	</attack>

	<attack>
<% $rand_name2 = SecureRandom.hex(3) %>
		<pre_shell>scp -i /opt/hackerbot/keys/id_rsa -prv -oStrictHostKeyChecking=no root@{{chat_ip_address}}:/home/<%= $main_user %>/evidence/<%= $rand_name2 %> /tmp/susp_pids; echo --$?; cat /tmp/susp_pids</pre_shell>
		<get_shell>false</get_shell>

		<prompt>Create a list of processes (pids) running on the system that are not reported by the local version of ps. Save to your Desktop VM in /home/<%= $main_user %>/evidence/<%= $rand_name2 %>.</prompt>

		<condition>
			<output_matches>\b2\b|\b3\b|\b4\b</output_matches>
			<message>:( Your list includes processes that are not hidden.</message>
		</condition>
    <condition>
			<output_matches>--1</output_matches>
			<message>:( Failed to get file.</message>
		</condition>
		<condition>
      <!-- TODO: be a bit more picky! -->
			<output_matches>.*</output_matches>
			<message>:) Well done! <%= $flags.pop %>.</message>
			<trigger_next_attack />
		</condition>
		<else_condition>
			<message>:( List is incomplete...</message>
		</else_condition>

	</attack>

	<attack>
<% $rand_name_mem = SecureRandom.hex(3) %>
		<pre_shell>scp -i /opt/hackerbot/keys/id_rsa -prv -oStrictHostKeyChecking=no root@{{chat_ip_address}}:/home/<%= $main_user %>/evidence/<%= $rand_name_mem %> /tmp/mem_flag; echo --$?; cat /tmp/mem_flag</pre_shell>
		<get_shell>false</get_shell>
		<prompt>A process on the compromised server is running from a binary that has already been deleted from disk, and it is dressed up to look like a kernel worker thread so the live tools list it as [kworker/...]. That is only the command line the tools print; the kernel still knows the task by the real name its binary was launched under. Recover that real process name from the memory image and save it to your Desktop VM in /home/<%= $main_user %>/evidence/<%= $rand_name_mem %>.</prompt>

		<condition>
			<output_matches>--1</output_matches>
			<message>:( Failed to get file.</message>
		</condition>
		<condition>
			<output_matches><%= $deleted_proc_name %></output_matches>
			<message>:) Well done! <%= $flags.pop %>.</message>
			<trigger_next_attack />
		</condition>
		<else_condition>
			<message>:( That is not the task's real name. [kworker/...] is the argv disguise; read the comm field from linux.psscan instead.</message>
		</else_condition>

	</attack>

	<attack>
<% $rand_name_sock = SecureRandom.hex(3) %>
		<pre_shell>scp -i /opt/hackerbot/keys/id_rsa -prv -oStrictHostKeyChecking=no root@{{chat_ip_address}}:/home/<%= $main_user %>/evidence/<%= $rand_name_sock %> /tmp/hidden_sock; echo --$?; cat /tmp/hidden_sock</pre_shell>
		<get_shell>false</get_shell>
		<prompt>The backdoor you found listening on that port earlier runs as a process, but the rootkit hides it from the live tools (ps, top) just as it hid the port. The memory capture is not fooled. Find the backdoor's process in the image and save its process name to your Desktop VM in /home/<%= $main_user %>/evidence/<%= $rand_name_sock %>.</prompt>

		<condition>
			<output_matches>--1</output_matches>
			<message>:( Failed to get file.</message>
		</condition>
		<condition>
			<output_matches><%= $nc_proc_name %></output_matches>
			<message>:) Well done! <%= $flags.pop %>.</message>
			<trigger_next_attack />
		</condition>
		<else_condition>
			<message>:( That is not the backdoor's process name. The rootkit hides it from ps, so read the comm field from linux.psscan instead.</message>
		</else_condition>

	</attack>

	<attack>
<% $rand_name_env = SecureRandom.hex(3) %>
		<pre_shell>scp -i /opt/hackerbot/keys/id_rsa -prv -oStrictHostKeyChecking=no root@{{chat_ip_address}}:/home/<%= $main_user %>/evidence/<%= $rand_name_env %> /tmp/env_token; echo --$?; cat /tmp/env_token</pre_shell>
		<get_shell>false</get_shell>
		<prompt>A daemon on the compromised server holds a secret in its process environment, in a variable named TELEMETRY_TOKEN. It is written to no file on disk, so it survives only in the process's memory and is carried inside the RAM capture. Recover the token (the value after the = sign) from the image and save it to your Desktop VM in /home/<%= $main_user %>/evidence/<%= $rand_name_env %>.</prompt>

		<condition>
			<output_matches>--1</output_matches>
			<message>:( Failed to get file.</message>
		</condition>
		<condition>
			<output_matches><%= $env_token %></output_matches>
			<message>:) Well done! <%= $flags.pop %>.</message>
			<trigger_next_attack />
		</condition>
		<else_condition>
			<message>:( That is not the token. The value lives in the daemon's environment inside the capture: search the raw image for TELEMETRY_TOKEN= (for example with strings and grep, or read it with Volatility's linux.envars) and take the value after the = sign.</message>
		</else_condition>

	</attack>

	<attack>
<% $rand_name_bash = SecureRandom.hex(3) %>
		<pre_shell>scp -i /opt/hackerbot/keys/id_rsa -prv -oStrictHostKeyChecking=no root@{{chat_ip_address}}:/home/<%= $main_user %>/evidence/<%= $rand_name_bash %> /tmp/bash_token; echo --$?; cat /tmp/bash_token</pre_shell>
		<get_shell>false</get_shell>
		<prompt>An interactive shell is still running on the compromised server. One command it ran carries a token, but the shell was told not to write its history to disk, so the command is in no ~/.bash_history file. It is still held in the running shell's in-memory history, inside the RAM capture. Recover the token from that command and save it to your Desktop VM in /home/<%= $main_user %>/evidence/<%= $rand_name_bash %>.</prompt>

		<condition>
			<output_matches>--1</output_matches>
			<message>:( Failed to get file.</message>
		</condition>
		<condition>
			<output_matches><%= $bash_token %></output_matches>
			<message>:) Well done! <%= $flags.pop %>.</message>
			<trigger_next_attack />
		</condition>
		<else_condition>
			<message>:( That is not the token. The command is in the running shell's in-memory history inside the capture (search the raw image with strings, or read it with Volatility's linux.bash), not in a history file on disk.</message>
		</else_condition>

	</attack>

