<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Hackerbot</title>
<style>
  body { font-family: sans-serif; margin: 0; display: flex; flex-direction: column; height: 100vh; background: #1e1e1e; color: #ddd; }
  #log { flex: 1; overflow-y: auto; padding: 1em; }
  #log p { margin: 0 0 0.5em 0; white-space: pre-wrap; }
  #log .me { color: #7ec4ff; }
  #log .bot { color: #9dff9d; }
  #log .status { color: #888; font-style: italic; }
  form { display: flex; padding: 0.5em; background: #2a2a2a; }
  input { flex: 1; padding: 0.5em; font-size: 1em; }
  button { padding: 0.5em 1em; font-size: 1em; }
</style>
</head>
<body>
<div id="log"></div>
<form id="f">
  <input id="msg" autocomplete="off" autofocus>
  <button type="submit">Send</button>
</form>
<script>
(function () {
  var NICK = <%= @username.to_json %>;
  var TARGET = <%= @hackerbot_nick.to_json %>;
  var WS_URL = "ws://" + <%= @irc_server_ip.to_json %> + ":8097/";

  var logEl = document.getElementById('log');
  var registered = false;
  var sock;

  function status(text) {
    var p = document.createElement('p');
    p.className = 'status';
    p.textContent = text;
    logEl.appendChild(p);
    logEl.scrollTop = logEl.scrollHeight;
  }

  function line(cls, from, text) {
    var p = document.createElement('p');
    p.className = cls;
    p.textContent = '<' + from + '> ' + text;
    logEl.appendChild(p);
    logEl.scrollTop = logEl.scrollHeight;
  }

  // Minimal IRC line parser (tags, prefix, command, params, trailing).
  function parseIrcLine(raw) {
    var s = raw;
    if (s.charAt(0) === '@') {
      var tagEnd = s.indexOf(' ');
      s = s.slice(tagEnd + 1);
    }
    var prefix = '';
    if (s.charAt(0) === ':') {
      var pEnd = s.indexOf(' ');
      prefix = s.slice(1, pEnd);
      s = s.slice(pEnd + 1);
    }
    var trailing = null;
    var trailIdx = s.indexOf(' :');
    var rest = s;
    if (trailIdx !== -1) {
      trailing = s.slice(trailIdx + 2);
      rest = s.slice(0, trailIdx);
    }
    var params = rest.split(' ').filter(function (p) { return p.length > 0; });
    var command = params.shift();
    if (trailing !== null) params.push(trailing);
    return { prefix: prefix, command: command, params: params };
  }

  function send(raw) {
    sock.send(raw);
  }

  function connect() {
    status('Connecting to ' + WS_URL + ' as ' + NICK + '...');
    sock = new WebSocket(WS_URL, 'text.ircv3.net');

    sock.onopen = function () {
      send('NICK ' + NICK);
      send('USER ' + NICK + ' 0 * :' + NICK);
    };

    sock.onclose = function () {
      status('Disconnected.');
    };

    sock.onerror = function () {
      status('Connection error.');
    };

    sock.onmessage = function (ev) {
      var msg = parseIrcLine(ev.data);

      if (msg.command === 'PING') {
        send('PONG :' + msg.params[0]);
        return;
      }

      if (!registered && msg.command === '001') {
        registered = true;
        status('Connected. Starting conversation with ' + TARGET + '...');
        send('PRIVMSG ' + TARGET + ' :hello');
        return;
      }

      if (msg.command === 'PRIVMSG') {
        var from = msg.prefix.split('!')[0];
        var text = msg.params[msg.params.length - 1];
        var toSelf = msg.params[0].toLowerCase() === NICK.toLowerCase();
        var fromBot = from.toLowerCase() === TARGET.toLowerCase();
        if (toSelf && fromBot) {
          line('bot', from, text);
        }
      }
    };
  }

  document.getElementById('f').addEventListener('submit', function (e) {
    e.preventDefault();
    var input = document.getElementById('msg');
    var text = input.value;
    if (!text || !registered) return;
    send('PRIVMSG ' + TARGET + ' :' + text);
    line('me', NICK, text);
    input.value = '';
  });

  connect();
})();
</script>
</body>
</html>
