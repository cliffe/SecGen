<?xml version="1.0"?>

<utility xmlns="http://www.github/cliffe/SecGen/utility"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.github/cliffe/SecGen/utility">
  <name>Auditbeat</name>
  <author>Thomas Shaw</author>
  <author>Elastic</author>
  <module_license>Apache v2</module_license>
  <description>Installs Elastic Auditbeat from the Elastic apt repository and configures its auditd module to read rules from /etc/auditbeat/audit.rules.d, shipping events to Logstash (logstash_ip:logstash_port).</description>

  <type>log_tool</type>
  <platform>linux</platform>

  <read_fact>logstash_ip</read_fact>
  <read_fact>logstash_port</read_fact>

  <default_input into="logstash_ip">
    <value>localhost</value>
  </default_input>

  <default_input into="logstash_port">
    <value>5044</value>
  </default_input>

  <requires>
    <type>update</type>
  </requires>

  <!-- Note: unless explicitly included in the scenario this won't populate the elasticsearch + logstash IP/port correctly.-->
  <!-- <requires>
    <name>Filebeat</name>
  </requires> -->

</utility>
