<?xml version="1.0"?>

<utility xmlns="http://www.github/cliffe/SecGen/utility"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.github/cliffe/SecGen/utility">
  <name>Secondary Groups Module</name>
  <author>Z. Cliffe Schreuders</author>
  <module_license>Apache v2</module_license>
  <description>Creates a list of groups.
  </description>

  <type>system</type>
  <platform>linux</platform>

  <read_fact>groups</read_fact>

  <!-- default so the module provisions when a scenario supplies no groups;
       a scenario's own groups input overrides these -->
  <default_input into="groups">
    <value>secgen_staff</value>
    <value>secgen_students</value>
  </default_input>

  <requires>
    <module_path>utilities/unix/system/.*/accounts</module_path>
  </requires>

</utility>
