-- Store the password as an md5 hash so md5 pg_hba auth works and the dumped hash
-- is trivially crackable. password_encryption is a session GUC read when the
-- password is set, so SET it before CREATE/ALTER ROLE.
SET password_encryption = 'md5';
DO $do$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = $secgen$<%= @username %>$secgen$) THEN
    EXECUTE format('CREATE ROLE %I SUPERUSER LOGIN PASSWORD %L', $secgen$<%= @username %>$secgen$, $secgen$<%= @password %>$secgen$);
  ELSE
    EXECUTE format('ALTER ROLE %I SUPERUSER LOGIN PASSWORD %L', $secgen$<%= @username %>$secgen$, $secgen$<%= @password %>$secgen$);
  END IF;
END
$do$;
