<?xml version="1.0"?>
<vulnerability xmlns="http://www.github/cliffe/SecGen/vulnerability"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.github/cliffe/SecGen/vulnerability">

  <name>WebDAV Upload to PHP Code Execution</name>
  <author>Tom Shaw</author>
  <module_license>MIT</module_license>
  <description>
    Turns an unauthenticated, writable Apache WebDAV collection into remote code
    execution by enabling mod_php in the serving Apache. Installs
    libapache2-mod-php so any .php file dropped into the WebDAV directory is
    executed by the interpreter when fetched, rather than served as text. An
    attacker who can PUT to the collection uploads a one-line PHP web shell and
    runs commands as the Apache user. This is the execution half of the chain:
    it pairs with apache_webdav_upload (the writable collection) to give a shell.
  </description>

  <type>remote</type>
  <privilege>user_rwx</privilege>
  <access>remote</access>
  <platform>linux</platform>
  <difficulty>low</difficulty>

  <cvss_base_score>8.8</cvss_base_score>
  <cvss_vector>AV:N/AC:L/Au:N/C:P/I:P/A:P</cvss_vector>
  <reference>https://httpd.apache.org/docs/2.4/mod/mod_dav.html</reference>
  <reference>https://owasp.org/www-community/attacks/Webdav</reference>
  <reference>https://owasp.org/www-community/attacks/Code_Injection</reference>

  <software_name>webdav_exec_method</software_name>

  <hint>The WebDAV collection now runs PHP: PUT a .php web shell and request it over GET to execute commands as www-data.</hint>

  <!-- Only one execution method (php or cgi) should be layered onto the
       collection; both enablers share this software_name and conflict on it. -->
  <conflict>
    <software_name>webdav_exec_method</software_name>
  </conflict>

  <!-- Must land on the same host as the writable WebDAV collection, and apply
       after it. apache_webdav_upload itself requires the Apache service, so this
       transitively orders mod_php after an already-prefork Apache too; requiring
       ".*apache" directly here as well would make the resolver try to select
       Apache a second time and hit its software_name self-conflict. -->
  <requires>
    <module_path>.*/apache_webdav_upload</module_path>
  </requires>

  <CyBOK KA="WAM" topic="Server-Side Vulnerabilities and Mitigations">
    <keyword>server-side misconfiguration and vulnerable components</keyword>
    <keyword>Vulnerable defaults</keyword>
  </CyBOK>
  <CyBOK KA="MAT" topic="Attacks and exploitation">
    <keyword>EXPLOITATION</keyword>
  </CyBOK>
</vulnerability>
