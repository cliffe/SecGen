/* Generated by SecGen. Prints the XOR-decoded token to stdout so the launcher
   can inject it into a shell without the plaintext ever appearing on disk;
   `strings` on this binary reveals nothing. */
#include <stdio.h>

static const unsigned char enc[] = { <%= @flag.bytes.map { |b| "0x%02x" % (b ^ 0x5a) }.join(', ') %> };
static const unsigned int enc_len = <%= @flag.bytesize %>;

int main(void) {
    unsigned int i;
    for (i = 0; i < enc_len; i++) {
        putchar(enc[i] ^ 0x5a);
    }
    return 0;
}
