/* Generated by SecGen. The real process name is stored XOR-obfuscated so
   `strings` on this binary reveals nothing; it is decoded into memory only
   while the process runs, where it becomes the task's comm. */
#include <string.h>
#include <unistd.h>
#include <sys/prctl.h>

static const unsigned char enc[] = { <%= @flag.bytes.map { |b| "0x%02x" % (b ^ 0x5a) }.join(', ') %> };
static const unsigned int enc_len = <%= @flag.bytesize %>;

/* decoded process name lives here, in RAM only */
static volatile char secret[512];

int main(int argc, char **argv) {
    unsigned int i;
    for (i = 0; i < enc_len && i < sizeof(secret) - 1; i++) {
        secret[i] = enc[i] ^ 0x5a;
    }
    secret[i] = '\0';

    /* Set the kernel task name (comm) to the real, per-build random name, but
       overwrite the argument vector to masquerade as a kernel worker thread.
       Live tools that print argv show "[kworker/1:0H]"; the comm field that
       Volatility's psscan reads from the task_struct still holds the real name. */
    prctl(PR_SET_NAME, (char *) secret, 0, 0, 0);
    if (argc > 0 && argv[0] != 0) {
        memset(argv[0], 0, strlen(argv[0]));
        strncpy(argv[0], "[kworker/1:0H]", 14);
    }

    for (;;) {
        pause();
    }
    return 0;
}
