/* Generated by SecGen. The token is stored XOR-obfuscated so `strings` on this
   binary reveals nothing. It is decoded into this process's environment at
   runtime, then inherited by the sleeper this process becomes (execlp), so the
   plaintext exists only in that process's memory and is recoverable from a RAM
   image by searching the raw capture (strings), never from a file on disk. */
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

static const unsigned char enc[] = { <%= @flag.bytes.map { |b| "0x%02x" % (b ^ 0x5a) }.join(', ') %> };
static const unsigned int enc_len = <%= @flag.bytesize %>;

int main(void) {
    char buf[512];
    unsigned int i;

    for (i = 0; i < enc_len && i < sizeof(buf) - 1; i++) {
        buf[i] = enc[i] ^ 0x5a;
    }
    buf[i] = '\0';

    /* The decoded value goes into the environment, which execlp hands to the
       kernel as envp; the new process gets a fresh copy on its stack. */
    setenv("TELEMETRY_TOKEN", buf, 1);
    memset(buf, 0, sizeof(buf));

    execlp("sleep", "sleep", "infinity", (char *)NULL);
    return 1;
}
