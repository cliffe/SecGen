<?xml version="1.0"?>

<vulnerability xmlns="http://www.github/cliffe/SecGen/vulnerability"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/vulnerability">
  <name>Netcat Backdoor</name>
  <author>Z. Cliffe Schreuders</author>
  <module_license>MIT</module_license>
  <description>A netcat backdoor (acts as a bind shell -- listens on a port and serves a shell). Strings are leaked to /root/.</description>

  <type>simple_backdoor</type>
  <type>bind_shell</type>
  <privilege>root_rwx</privilege>
  <access>remote</access>
  <platform>unix</platform>
  <difficulty>low</difficulty>

  <read_fact>port</read_fact>
  <read_fact>strings_to_leak</read_fact>
  <read_fact>leaked_filenames</read_fact>
  <read_fact>proc_name</read_fact>
  <read_fact>session_ref</read_fact>

  <default_input into="port">
    <generator module_path=".*random_unregistered_port" />
  </default_input>

  <!-- Optional: run the listener under this process name instead of plain
       "ncat" (via a renamed link), so its kernel task name (comm) is a known,
       per-build value a memory-forensics exercise can ask a student to recover.
       Empty by default, which keeps the original "ncat" behaviour unchanged. -->
  <default_input into="proc_name">
    <value></value>
  </default_input>

  <!-- Optional: a session-reference string carried in the listener's command
       line (via ncat -c "BACKDOOR_SESSION_ID=<ref> /bin/bash"), so the value is
       recoverable from the process arguments in a memory image. Empty by
       default, which keeps the original "-e /bin/bash" invocation unchanged. -->
  <default_input into="session_ref">
    <value></value>
  </default_input>

  <default_input into="strings_to_leak">
    <generator type="message_generator"/>
    <generator type="message_generator"/>
  </default_input>

  <default_input into="leaked_filenames">
    <generator type="filename_generator"/>
    <generator type="filename_generator"/>
  </default_input>

  <!--optional vulnerability details-->
  <cvss_base_score>10</cvss_base_score>
  <cvss_vector>AV:N/AC:L/Au:N/C:C/I:C/A:C</cvss_vector>
  <software_name>nc</software_name>

  <!--optional hints-->
  <hint>Connect to a port</hint>
  <solution>Simply connecting to the right port will give you a root shell.</solution>

  <requires>
    <module_path>.*/puppet_module/cron.*</module_path>
  </requires>
  <requires>
    <type>update</type>
  </requires>

  <CyBOK KA="MAT" topic="Attacks and exploitation">
    <keyword>EXPLOITATION</keyword>
    <keyword>BACKDOOR TROJANS</keyword>
  </CyBOK>
  <CyBOK KA="SOIM" topic="PENETRATION TESTING">
    <keyword>PENETRATION TESTING - SOFTWARE TOOLS</keyword>
    <keyword>PENETRATION TESTING - NETWORK MAPPING - RECONNAISSANCE</keyword>
    <keyword>PENETRATION TESTING - ACTIVE PENETRATION</keyword>
  </CyBOK>
  <CyBOK KA="NS" topic="PENETRATION TESTING">
    <keyword>PENETRATION TESTING - NETWORK MAPPING - FINGERPRINTING</keyword>
    <keyword>PENETRATION TESTING - NETWORK MAPPING - NMAP</keyword>
  </CyBOK>

</vulnerability>
