<?xml version="1.0"?>
<vulnerability xmlns="http://www.github/cliffe/SecGen/vulnerability"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.github/cliffe/SecGen/vulnerability">
  
  <name>Drupal 8.5.0 RCE</name>
  <author>Alix Hiscock</author>
  <module_license>MIT</module_license>
  <description>
    Drupal 8.5.0 is vulnerable to two unauthenticated remote code execution issues: CVE-2018-7600 
    and CVE-2019-6340 in the REST API. An attacker can send crafted HTTP requests that abuse unsafe
    input handling in Drupal’s form and REST subsystems, bypassing normal access controls and resulting
    in remote code execution.
  </description>

  <type>webapp</type>
  <privilege>user_rwx</privilege>
  <access>remote</access>
  <platform>linux</platform>
  <difficulty>low</difficulty>

  <read_fact>port</read_fact>
  <read_fact>strings_to_leak</read_fact>
  <read_fact>strings_to_pre_leak</read_fact>

  <default_input into="port">
    <value>80</value>
  </default_input>

  <default_input into="strings_to_leak">
    <generator type="message_generator"/>
  </default_input>

  <default_input into="strings_to_pre_leak">
    <generator type="message_generator"/>
  </default_input>

  <cve>CVE-2018-7600</cve>
  <cvss_base_score>9.8</cvss_base_score>
  <cvss_vector>AV:N/AC:L/Au:N/C:C/I:C/A:C</cvss_vector>

  <msf_module>exploit/unix/webapp/drupal_drupalgeddon2</msf_module>
  <hint> Visit the webapp at http://IP:80 </hint>
  <solution>
    Remote code execution vulnerability can be exploited with metasploit.
    Look in /var/www/drupal-8.5.0 files and a common location for web crawlers to visit...
  </solution>

  <conflict>
    <type>webapp</type>
  </conflict>


  <!-- Patched PHP 7.4 (php2shell fix); Drupalgeddon2 is an app vuln, so only
       CVE-2018-7600 is exploitable, not php2shell. Served via php-fpm. -->
  <requires>
    <module_path>.*utilities/unix/languages/php7_patched.*</module_path>
  </requires>

</vulnerability>
