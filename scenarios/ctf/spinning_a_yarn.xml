<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Spinning a Yarn</name>
  <author>Tom Shaw</author>
  <description>
    A single-node big-data cluster has been stood up on the target with its
    out-of-the-box settings. The component that schedules work across the
    cluster exposes a REST API, and nobody turned on authentication, so it will
    accept a job from anyone who can reach it. Submit the right job and the
    cluster runs your command. The single flag is waiting in the cluster
    account's home directory.
  </description>

  <type>ctf</type>
  <type>attack-ctf</type>
  <type>pwn-ctf</type>
  <difficulty>medium</difficulty>

  <CyBOK KA="WAM" topic="Server-Side Vulnerabilities and Mitigations">
    <keyword>server-side misconfiguration and vulnerable components</keyword>
    <keyword>Remote code execution</keyword>
  </CyBOK>
  <CyBOK KA="MAT" topic="Attacks and exploitation">
    <keyword>EXPLOITATION</keyword>
    <keyword>EXPLOITATION FRAMEWORKS</keyword>
  </CyBOK>
  <CyBOK KA="SS" topic="Categories of Vulnerabilities">
    <keyword>CVEs and CWEs</keyword>
  </CyBOK>
  <CyBOK KA="SOIM" topic="PENETRATION TESTING">
    <keyword>PENETRATION TESTING - ACTIVE PENETRATION</keyword>
    <keyword>PENETRATION TESTING - NETWORK MAPPING - RECONNAISSANCE</keyword>
  </CyBOK>
  <CyBOK KA="NS" topic="PENETRATION TESTING">
    <keyword>PENETRATION TESTING - NETWORK MAPPING - FINGERPRINTING</keyword>
    <keyword>PENETRATION TESTING - NETWORK MAPPING - NMAP</keyword>
  </CyBOK>

  <system>
    <system_name>attack_vm</system_name>
    <base distro="Kali" name="MSF"/>

    <input into_datastore="IP_addresses">
      <!-- 0 attack_vm -->
      <network_ip system="attack_vm"/>
      <!-- 1 target -->
      <network_ip system="target"/>
    </input>

    <utility module_path=".*/parameterised_accounts">
      <input into="accounts">
        <value>{"username":"kali","password":"kali","super_user":"true","strings_to_leak":[],"leaked_filenames":[]}</value>
      </input>
    </utility>

    <utility module_path=".*/iceweasel">
      <input into="accounts">
        <value>{"username":"kali","password":"kali","super_user":"true","strings_to_leak":[],"leaked_filenames":[]}</value>
      </input>
      <input into="autostart"><value>false</value></input>
    </utility>

    <utility module_path=".*/kali_top10"/>
    <utility module_path=".*/kali_web"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password"><datastore>spoiler_admin_pass</datastore></input>
    </build>
  </system>

  <system>
    <system_name>target</system_name>
    <base distro="Debian 12" type="desktop" name="KDE"/>

    <!-- foothold + flag: unauthenticated YARN ResourceManager job submission
         runs commands as the hadoop user; flag lands in /home/hadoop -->
    <vulnerability module_path=".*/hadoop_yarn_rce">
      <input into="leaked_filenames">
          <value>flag.txt</value>
      </input>
      <input into="strings_to_leak">
          <generator type="flag_generator"/>
      </input>
    </vulnerability>

    <network type="private_network"/>
    <build type="cleanup">
      <input into="root_password"><datastore>spoiler_admin_pass</datastore></input>
    </build>
  </system>

</scenario>
