  <system>
    <system_name>desktop</system_name>
    <base distro="Debian 12" type="desktop" name="KDE"/>

    <input into_datastore="main_username">
      <generator type="random_sanitised_word">
        <input into="wordlist">
          <value>mythical_creatures</value>
        </input>
      </generator>
    </input>
    <input into_datastore="hidden_string">
      <generator module_path=".*/random_hex"/>
    </input>
    <input into_datastore="nc_port">
      <generator module_path=".*/random_unregistered_port" />
    </input>
    <!-- Values students recover from the memory image. None is a flag{...}, so
         none is greppable as a flag and none can be guessed; each is a per-build
         random property of a real artefact (a process name, an env token, an
         in-memory command token). Hackerbot checks the recovered value and hands
         back the reward flag separately. -->
    <!-- ch3: the deleted-binary process's real kernel name (comm). random_hex
         emits 2x line_length hex chars, so 6 => a 12-char name, kept <=15 so the
         kernel does not truncate comm and psscan reports it whole. -->
    <input into_datastore="deleted_proc_name">
      <generator module_path=".*/random_hex">
        <input into="line_length">
          <value>6</value>
        </input>
      </generator>
    </input>
    <!-- ch4: the netcat backdoor's masqueraded process name (comm). 6 => 12
         chars (random_hex doubles line_length), <=15 so comm is not truncated. -->
    <input into_datastore="nc_proc_name">
      <generator module_path=".*/random_hex">
        <input into="line_length">
          <value>6</value>
        </input>
      </generator>
    </input>
    <!-- ch1: the backdoor listener's session marker, carried on its command
         line as BACKDOOR_SESSION_ID=<token>. Recovered from the image with
         linux.psaux (process argument vector), not strings/psscan. 6 => 12 hex. -->
    <input into_datastore="nc_ref_token">
      <generator module_path=".*/random_hex">
        <input into="line_length">
          <value>6</value>
        </input>
      </generator>
    </input>
    <!-- ch5: the value of the TELEMETRY_TOKEN env var on the sleeper process. -->
    <input into_datastore="env_token">
      <generator module_path=".*/random_hex"/>
    </input>
    <!-- ch6: the token carried by the command in the running shell's history. -->
    <input into_datastore="bash_token">
      <generator module_path=".*/random_hex"/>
    </input>

    <input into_datastore="IP_addresses">
      <!-- desktop -->
      <network_ip system="desktop"/>
      <!-- hackerbot -->
      <network_ip system="hackerbot_server"/>
      <!-- compromised -->
      <network_ip system="compromised_server"/>
    </input>

    <!-- "accounts_compromised" is specified below -->
    <input into_datastore="accounts">
      <generator type="account">
        <input into="username">
          <datastore>main_username</datastore>
        </input>
        <input into="password">
          <value>tiaspbiqe2r</value>
        </input>
        <input into="super_user">
          <value>true</value>
        </input>
      </generator>
    </input>

    <!-- an admin account used for hackerbot access to the desktop and also spoilers/administration of the challenge -->
    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <input into_datastore="hackerbot_key">
      <generator type="ssh_key_pair"/>
    </input>

    <!--Create the users-->
    <utility module_path=".*/parameterised_accounts">
      <input into="accounts">
        <datastore>accounts</datastore>
      </input>
    </utility>

    <utility module_path=".*/kde_minimal">
      <input into="autologin_user">
        <datastore access="0" access_json="['username']">accounts</datastore>
      </input>
      <input into="accounts">
        <datastore>accounts</datastore>
      </input>
      <input into="autostart_konsole">
        <value>true</value>
      </input>
    </utility>
    <utility module_path=".*/handy_cli_tools"/>
    <utility module_path=".*/binary_tools"/>
    <utility module_path=".*/nmap"/>
    <!-- memory forensics workstation: analyse RAM captures here, not on the compromised box -->
    <utility module_path=".*/volatility3"/>

    <!-- Places an atomic (hypervisor-paused) RAM image of the compromised
         server in the analyst's ~/evidence, rewriting the baked artefact tokens
         to this build's per-build values so the answers are unique. It is a
         capture of a different randomised instance of the same system. Students
         also capture the live server themselves (see the compromised_server's
         LiME) and find the list-walking plugins unreliable on that non-atomic
         image; this atomic capture is the consistent snapshot where full
         structured analysis works. -->
    <utility module_path=".*/prepackaged_memory_image">
      <input into="account">
        <datastore access="0">accounts</datastore>
      </input>
      <input into="deleted_proc_name">
        <datastore>deleted_proc_name</datastore>
      </input>
      <input into="nc_proc_name">
        <datastore>nc_proc_name</datastore>
      </input>
      <input into="nc_ref_token">
        <datastore>nc_ref_token</datastore>
      </input>
      <input into="env_token">
        <datastore>env_token</datastore>
      </input>
      <input into="bash_token">
        <datastore>bash_token</datastore>
      </input>
    </utility>

    <utility module_path=".*/hosts">
      <input into="hosts">
        <value>hackerbot</value>
      </input>
      <input into="IP_addresses">
        <datastore access="1">IP_addresses</datastore>
      </input>
    </utility>

    <utility module_path=".*/iceweasel">
      <input into="accounts">
        <datastore access="0">accounts</datastore>
      </input>
      <input into="start_page">
        <value>hackerbot:8080</value>
      </input>
    </utility>

    <utility module_path=".*/hackerbot_client">
      <input into="ssh_key_pair">
        <datastore>hackerbot_key</datastore>
      </input>
    </utility>

    <network type="private_network"/>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>


  <system>
    <system_name>hackerbot_server</system_name>
    <base distro="Kali" name="MSF"/>

    <service module_path=".*/ergochat"/>

    <utility module_path=".*/hackerbot_webclient">
      <input into="username">
        <datastore access="0" access_json="['username']">accounts</datastore>
      </input>
      <input into="irc_server_ip">
        <value>hackerbot</value>
      </input>
    </utility>

    <utility module_path=".*/metasploit_framework"/>
    <utility module_path=".*/handy_cli_tools"/>
    <utility module_path=".*/nmap"/>

    <service type="httpd"/>

    <utility module_path=".*/hackerbot">
      <input into="ssh_key_pair">
        <datastore>hackerbot_key</datastore>
      </input>
      <input into="hackerbot_configs">
        <generator module_path=".*/live_analysis_v2">
          <input into="accounts">
            <datastore>accounts</datastore>
          </input>

          <input into="hackerbot_server_ip">
            <datastore access="1">IP_addresses</datastore>
          </input>
          <input into="compromised_server_ip">
            <datastore access="2">IP_addresses</datastore>
          </input>
          <input into="hidden_port">
            <datastore>nc_port</datastore>
          </input>
          <input into="hidden_string">
            <datastore>hidden_string</datastore>
          </input>
          <input into="deleted_proc_name">
            <datastore>deleted_proc_name</datastore>
          </input>
          <input into="nc_proc_name">
            <datastore>nc_proc_name</datastore>
          </input>
          <input into="nc_ref_token">
            <datastore>nc_ref_token</datastore>
          </input>
          <input into="env_token">
            <datastore>env_token</datastore>
          </input>
          <input into="bash_token">
            <datastore>bash_token</datastore>
          </input>
        </generator>
      </input>
    </utility>

    <network type="private_network"/>

    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>


    <system>
      <system_name>compromised_server</system_name>
      <!-- Cap RAM so the student's own in-guest capture (via LiME, below) stays
           small and quick to copy and analyse. That live capture is part of the
           lab by design: taken while the kernel keeps running, it is non-atomic,
           so Volatility's list-walking plugins (pslist, linux.psaux,
           linux.envars, linux.bash) give unreliable results on it. Students see
           that first-hand, then analyse the atomic, hypervisor-paused capture
           shipped to the desktop (prepackaged_memory_image), where the same
           plugins work. String search and pool scanning (psscan) are the
           techniques that survive the live smear. -->
      <memory_cap>1536</memory_cap>
      <base distro="Debian 12" type="desktop" name="KDE"/>


      <input into_datastore="accounts_compromised">
        <generator type="account">
          <input into="username">
            <datastore>main_username</datastore>
          </input>
          <input into="password">
            <value>tiaspbiqe2r</value>
          </input>
          <input into="super_user">
            <value>true</value>
          </input>
          <input into="leaked_filenames">
            <value>u_r_powned-hme</value>
            <value>.a_hidden_flag-hme</value>
            <datastore>hidden_string</datastore>
          </input>
          <input into="strings_to_leak">
            <generator type="random_line_generator">
              <input into="linelist">
                <value>powned_messages</value>
              </input>
            </generator>
            <generator type="flag_generator" />
            <generator type="flag_generator" />
          </input>
        </generator>
      </input>

      <!-- Install LiME as /proc/kcore dump doesn't work with 64-bit bases since Linux 4.8 -->
      <utility module_path=".*./lime"/>

      <!-- Disable KASLR so the kernel loads at its fixed base and stays below the
           high-memory boundary, keeping the memory capture's layout deterministic
           and resolvable by Volatility -->
      <utility module_path=".*/disable_kaslr"/>

      <vulnerability module_path=".*/nc_backdoor">
        <input into="port">
          <datastore>nc_port</datastore>
        </input>
        <!-- Run the listener under a per-build random process name so a student
             who recovers it from the memory image submits a build-unique value,
             not the shared literal "ncat". The rootkit hides this name from live
             tools; psscan reveals the process's real comm. -->
        <input into="proc_name">
          <datastore>nc_proc_name</datastore>
        </input>
        <!-- ch1: carry a per-build session marker on the listener's command line
             (ncat -c "BACKDOOR_SESSION_ID=<ref> /bin/bash"), recoverable from the
             image's process argument vectors with linux.psaux. -->
        <input into="session_ref">
          <datastore>nc_ref_token</datastore>
        </input>
      </vulnerability>

      <!-- rootkit has to be defined before accounts are created -->
      <utility module_path=".*/alias_rootkit">
        <input into="hidden_ports">
          <datastore>nc_port</datastore>
        </input>
        <input into="hidden_strings">
          <value>ncat</value>
          <value>hme</value>
          <datastore>hidden_string</datastore>
          <datastore>nc_proc_name</datastore>
        </input>
      </utility>

      <!-- a process running from a deleted binary; its real kernel name (comm)
           is a per-build random value the student recovers with psscan -->
      <vulnerability module_path=".*/deleted_binary_process">
        <input into="flag">
          <datastore>deleted_proc_name</datastore>
        </input>
      </vulnerability>

      <!-- a daemon holding a per-build random token in its process environment
           (TELEMETRY_TOKEN), recoverable from the image with strings -->
      <vulnerability module_path=".*/env_secret_process">
        <input into="flag">
          <datastore>env_token</datastore>
        </input>
      </vulnerability>

      <!-- a running shell whose in-memory history carries a per-build random
           token, recoverable from the image with strings -->
      <vulnerability module_path=".*/bash_history_artefact">
        <input into="flag">
          <datastore>bash_token</datastore>
        </input>
      </vulnerability>

      <!-- required for chkrootkit -->
      <utility module_path=".*/binary_tools"/>

      <!-- A statically linked BusyBox, standing in for the known-good tools a
           responder brings on read-only media. Its ps/ls/netstat/cat are not
           subverted by the alias_rootkit above (different command name, bypasses
           the shell aliases) nor, in the real world, by an LD_PRELOAD /
           ld.so.preload userland rootkit (static, so no victim libc or loader).
           The lab sheet uses it to teach trusted-tool discipline and its limit:
           a kernel rootkit still defeats it, which is why the student then turns
           to memory forensics. -->
      <utility module_path=".*/busybox_static"/>

      <utility module_path=".*/parameterised_accounts">
        <input into="accounts">
          <datastore>accounts_compromised</datastore>
        </input>
      </utility>

      <service module_path=".*/vsftpd"/>

      <service type="pop3"/>

      <service module_path="services/unix/http/parameterised_website">
        <!-- <input into="organisation">
          <datastore>organisation</datastore>
        </input> -->
      </service>

      <utility module_path=".*/hackerbot_client">
        <input into="ssh_key_pair">
          <datastore>hackerbot_key</datastore>
        </input>
      </utility>

      <network type="private_network"/>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
    </system>

</scenario>
