<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: bind9</name>
  <author>Thomas Shaw</author>
  <description>Two-VM test scenario for the bind9 service: a Debian 12 target and a Kali/MSF attacker on the same private network, used to exercise the module's secgen_test via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>bind9_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="bind9_target"/>
      <network_ip system="attacker"/>
    </input>

    <service module_path=".*/bind9">
      <input into="dns_records">
        <generator module_path=".*/dns_record">
          <input into="hostname">
            <value>www</value>
          </input>
          <input into="type">
            <value>a</value>
          </input>
          <input into="value">
            <value>192.168.99.10</value>
          </input>
        </generator>
        <generator module_path=".*/dns_record">
          <input into="hostname">
            <value>alias</value>
          </input>
          <input into="type">
            <value>cname</value>
          </input>
          <input into="value">
            <value>www.secgen.local</value>
          </input>
        </generator>
        <generator module_path=".*/dns_record">
          <input into="hostname">
            <value>info</value>
          </input>
          <input into="type">
            <value>txt</value>
          </input>
          <input into="value">
            <value>v=secgen-test</value>
          </input>
        </generator>
        <generator module_path=".*/dns_record">
          <input into="hostname">
            <value>@</value>
          </input>
          <input into="type">
            <value>mx</value>
          </input>
          <input into="value">
            <value>mail.secgen.local</value>
          </input>
          <input into="priority">
            <value>10</value>
          </input>
        </generator>
      </input>
    </service>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
