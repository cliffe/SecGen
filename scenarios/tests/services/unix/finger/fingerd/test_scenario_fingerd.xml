<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: fingerd</name>
  <author>Thomas Shaw</author>
  <description>Two-VM test scenario for the fingerd service (finger user enumeration): a Debian 12 target and a Kali/MSF attacker on the same private network, used to exercise the module's secgen_test via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>fingerd_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="accounts">
      <generator type="account">
        <input into="username"><value>fingeralice</value></input>
        <input into="password"><generator type="strong_password_generator"/></input>
        <input into="super_user"><value>false</value></input>
      </generator>
    </input>

    <input into_datastore="IP_addresses">
      <network_ip system="fingerd_target"/>
      <network_ip system="attacker"/>
    </input>

    <utility module_path="modules/utilities/unix/system/parameterised_accounts">
      <input into="accounts">
        <datastore>accounts</datastore>
      </input>
    </utility>
    <service module_path=".*/fingerd"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
