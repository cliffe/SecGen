<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: ELK combined (elasticsearch, logstash, kibana)</name>
  <author>Thomas Shaw</author>
  <description>Three-module regression test: all three Elastic stack services on a single Debian 12 target. Verifies that kibana, elasticsearch and logstash coexist without conflicting over the shared Elastic apt repository.</description>

  <type>test</type>

  <system>
    <system_name>elk_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="elk_target"/>
      <network_ip system="attacker"/>
    </input>

    <service module_path=".*/elasticsearch"/>
    <service module_path=".*/logstash"/>
    <service module_path=".*/kibana"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
