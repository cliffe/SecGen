<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: kali_reverse_engineering</name>
  <author>Thomas Shaw</author>
  <description>Single-VM Kali test scenario for the kali_reverse_engineering utility module, used to exercise its secgen_test via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>kali_reverse_engineering_testing</system_name>
    <base distro="Kali" name="MSF"/>

    <utility module_path=".*/kali_metapackages/kali_reverse_engineering"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

</scenario>
