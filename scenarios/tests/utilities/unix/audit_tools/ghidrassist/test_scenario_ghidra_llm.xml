<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: Ghidra LLM assistant via relay</name>
  <author>Thomas Shaw</author>
  <description>Two VMs for testing the Ghidra LLM assistant: a relay VM running llm_relay, with an
  internal_network NIC as well as its lab network, and a Kali VM with Ghidra and the GhidrAssist plugin
  pointed at the relay on the isolated lab network. Without an API key (secgen.rb's llm-api-key option)
  the gateway answering 401 through the relay is the expected result.</description>

  <type>test</type>

  <system>
    <system_name>llm_relay</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="llm_relay"/>
      <network_ip system="ghidra_kali"/>
    </input>

    <utility module_path=".*/llm_relay"/>

    <network type="private_network"/>
    <network type="internal_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>ghidra_kali</system_name>
    <base distro="Kali" name="MSF"/>

    <utility module_path=".*/parameterised_accounts">
      <input into="accounts">
        <value>{"username":"kali","password":"kali","super_user":"true","strings_to_leak":[],"leaked_filenames":[]}</value>
      </input>
    </utility>

    <utility module_path=".*/ghidrassist">
      <input into="llm_relay_ip">
        <datastore access="0">IP_addresses</datastore>
      </input>
    </utility>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_kali">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_kali</datastore>
      </input>
    </build>
  </system>

</scenario>
