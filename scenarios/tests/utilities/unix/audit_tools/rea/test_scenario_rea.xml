<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: REA agent tooling with OpenCode and Ghidra</name>
  <author>Thomas Shaw</author>
  <description>Two VMs for testing REA as an MCP tool server and the modules it needs. A relay VM runs
  llm_relay with a leg on the internal network, where the LLM gateway is. A Kali VM gets Node.js, OpenCode
  configured against the relay, Ghidra, and REA registered as an MCP server for OpenCode, plus one metactf
  challenge to decompile. Selecting rea pulls in opencode, nodejs and ghidra, so one build runs the
  nodejs, opencode and rea module tests together.</description>

  <type>test</type>

  <system>
    <system_name>llm_relay</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="llm_relay"/>
      <network_ip system="ghidra_kali"/>
    </input>

    <utility module_path=".*/llm_relay"/>

    <network type="private_network"/>
    <network type="internal_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>ghidra_kali</system_name>
    <base distro="Kali" name="MSF"/>

    <input into_datastore="account">
      <value>{"username":"student","password":"tiaspbiqe2r","super_user":"false","strings_to_leak":[],"leaked_filenames":[]}</value>
    </input>

    <utility module_path=".*/parameterised_accounts">
      <input into="accounts">
        <datastore>account</datastore>
      </input>
    </utility>

    <utility module_path=".*/reversing_tools"/>

    <utility module_path=".*/opencode">
      <input into="llm_relay_ip">
        <datastore access="0">IP_addresses</datastore>
      </input>
    </utility>

    <utility module_path=".*/rea"/>

    <utility module_path=".*/metactf">
      <input into="account">
        <datastore>account</datastore>
      </input>
      <input into="challenge_list">
        <generator type="metactf_challenge">
          <input into="challenge_path">
            <value>src_malware/Ch11-13/Ch13DataEnc_XorEnc</value>
          </input>
        </generator>
      </input>
    </utility>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_kali">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_kali</datastore>
      </input>
    </build>
  </system>

</scenario>
