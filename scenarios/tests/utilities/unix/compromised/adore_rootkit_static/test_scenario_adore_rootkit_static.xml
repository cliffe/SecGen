<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: adore_rootkit_static</name>
  <author>Thomas Shaw</author>
  <description>Single-VM test scenario for the adore_rootkit_static utility module, used to exercise its secgen_test via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>adore_rootkit_static_testing</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <utility module_path=".*/adore_rootkit_static"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

</scenario>
