<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: hosts</name>
  <author>Thomas Shaw</author>
  <description>Single-VM test scenario for the hosts utility module, used to exercise its secgen_test via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>hosts_testing</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <!-- hostnames[i] maps to IP_addresses[i]; without inputs SecGen sets no inputs-file fact and the module cannot run -->
    <utility module_path=".*/system/hosts">
      <input into="hostnames">
        <value>web.hosts-test.lan</value>
        <value>db.hosts-test.lan</value>
      </input>
      <input into="IP_addresses">
        <value>10.20.30.41</value>
        <value>10.20.30.42</value>
      </input>
    </utility>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

</scenario>
