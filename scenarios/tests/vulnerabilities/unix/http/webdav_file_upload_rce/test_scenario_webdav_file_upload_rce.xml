<?xml version="1.0"?>
<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: webdav_file_upload_rce</name>
  <author>Thomas Shaw</author>
  <description>
    Unauthenticated Apache WebDAV upload leading to a remote shell. The target
    exposes a writable WebDAV collection (apache_webdav_upload); the meta-module
    webdav_file_upload_rce adds exactly one execution method at random, PHP or
    CGI, so an attacker PUTs a matching web shell and runs commands as the Apache
    user. A Kali MSF attacker is included so the tier-3 exploit checks run.
  </description>

  <type>test</type>

  <system>
    <system_name>webdav_file_upload_rce_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="webdav_file_upload_rce_target"/>
      <network_ip system="attacker"/>
    </input>

    <!-- One line: pulls in the writable WebDAV collection plus a randomly
         selected execution enabler (php or cgi), and transitively the Apache
         service they both require. -->
    <vulnerability module_path=".*/webdav_file_upload_rce"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>
    <network type="private_network"/>
    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>
</scenario>
