<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: nfs_overshare</name>
  <author>Thomas Shaw</author>
  <description>Two-VM test scenario for the nfs_overshare vulnerability module: a Debian 12 target and a Kali/MSF attacker on the same private network, used to exercise the module's secgen_test via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>nfs_overshare_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="nfs_overshare_target"/>
      <network_ip system="attacker"/>
    </input>

    <vulnerability module_path=".*/nfs_overshare"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
