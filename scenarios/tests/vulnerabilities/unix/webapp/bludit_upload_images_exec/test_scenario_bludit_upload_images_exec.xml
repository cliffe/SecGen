<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: bludit_upload_images_exec</name>
  <author>Thomas Shaw</author>
  <description>Two-VM scenario that deploys Bludit 3.9.2 (CVE-2019-16113) on a Debian 10 Buster target running patched PHP 7.4 (php7_patched), with a Kali attacker on the same private network. Used to exercise the module's secgen_test (tiers 1-3) via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>bludit_target</system_name>
    <base platform="linux" distro="Debian 10" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="bludit_target"/>
      <network_ip system="attacker"/>
    </input>

    <vulnerability module_path=".*/bludit_upload_images_exec"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
