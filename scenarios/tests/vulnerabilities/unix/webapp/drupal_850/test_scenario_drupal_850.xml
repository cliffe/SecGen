<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: drupal_850</name>
  <author>Thomas Shaw</author>
  <description>Two-VM test scenario for the drupal_850 vulnerability module on patched PHP 7.4 (Debian 10 Buster): a Debian 10 target and a Kali/MSF attacker on the same private network, used to exercise the module's secgen_test (including the Drupalgeddon2 tier-3 exploit) via the Proxmox QEMU Guest Agent testing pipeline.</description>

  <type>test</type>

  <system>
    <system_name>drupal_850_target</system_name>
    <base platform="linux" distro="Debian 10" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="drupal_850_target"/>
      <network_ip system="attacker"/>
    </input>

    <vulnerability module_path=".*/drupal_850"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>
    <network type="private_network"/>
    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
