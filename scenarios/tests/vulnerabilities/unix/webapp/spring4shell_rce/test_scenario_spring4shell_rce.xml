<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: Spring4Shell (CVE-2022-22965) RCE</name>
  <author>Thomas Shaw</author>
  <description>Two-VM scenario used to exercise the spring4shell_rce module's
  secgen_test through tier 3 via the Proxmox QEMU Guest Agent pipeline: a Debian 12
  target running a vulnerable Spring MVC 5.3.17 application on Apache Tomcat 8.5.77
  (CVE-2022-22965, Spring4Shell) on port 8080, and a Kali/MSF attacker on the same
  private network that runs exploit/multi/http/spring_framework_rce_spring4shell
  against it.</description>

  <type>test</type>

  <system>
    <system_name>spring4shell_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="spring4shell_target"/>
      <network_ip system="attacker"/>
    </input>

    <vulnerability module_path=".*/spring4shell_rce"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
