<?xml version="1.0"?>

<scenario xmlns="http://www.github/cliffe/SecGen/scenario"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.github/cliffe/SecGen/scenario">

  <name>Test: Webmin Package Updates RCE</name>
  <author>Thomas Shaw</author>
  <description>Two-VM scenario used to exercise the webmin_package_updates_rce
  module's secgen_test through tier 3 via the Proxmox QEMU Guest Agent pipeline:
  a Debian 12 target running Webmin 1.996 (CVE-2022-36446 authenticated command
  injection in the Software Package Updates module) over HTTPS on port 10000,
  and a Kali/MSF attacker on the same private network that runs
  exploit/linux/http/webmin_package_updates_rce against it.</description>

  <type>test</type>

  <system>
    <system_name>webmin_target</system_name>
    <base platform="linux" distro="Debian 12" type="desktop"/>

    <input into_datastore="IP_addresses">
      <network_ip system="webmin_target"/>
      <network_ip system="attacker"/>
    </input>

    <vulnerability module_path=".*/webmin_package_updates_rce"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass</datastore>
      </input>
    </build>
  </system>

  <system>
    <system_name>attacker</system_name>
    <base distro="Kali" name="MSF"/>

    <network type="private_network"/>

    <input into_datastore="spoiler_admin_pass_attacker">
      <generator type="strong_password_generator"/>
    </input>
    <build type="cleanup">
      <input into="root_password">
        <datastore>spoiler_admin_pass_attacker</datastore>
      </input>
    </build>
  </system>

</scenario>
